{
  "manifest_version": 3,
  "name": "LOCK//IN AI Companion",
  "version": "0.1.0",
  "description": "Lets LOCK//IN AI see your current tab and gently steer the browser during a focus session.",
  "permissions": ["tabs", "alarms", "search"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["search-inject.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["result-filter.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {},
  "minimum_chrome_version": "116"
}
