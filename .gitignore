# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
release/
out/
.next/
next-env.d.ts

# build/ holds the app icon source assets (icon.ico/.icns/.png), which the
# release build needs — keep them tracked. Ignore only generated artifacts.
build/*
!build/icon.ico
!build/icon.icns
!build/icon.png
!build/icon-master.svg

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Electron packaging
release-builds/

# Tauri (in case it's revisited)
src-tauri/target/

# Misc
*.tsbuildinfo
.cache/
.parcel-cache/
coverage/
